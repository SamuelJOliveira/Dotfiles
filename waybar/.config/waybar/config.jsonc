{
    "layer": "bottom",
    "position": "top",
    "height": 22,
    "spacing": 0,
    "modules-left": ["sway/workspaces","sway/mode"],
    "modules-center": ["custom/clock"],
    "modules-right": ["sway/language", "pulseaudio", "battery", "backlight", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{icon}{name}",
        "format-icons": {
            "default": " ",
            "urgent": "!",
            "focused": "*"
        }
    },

    "sway/mode": {
        "format": "  {}"
    },

    "custom/clock": {
        "format": "<span color='#3a3a3a'>[ </span>{text}<span color='#3a3a3a'> ]</span>",
        "exec": "date +'%H:%M %A, %b %d' | awk '{print tolower($0)}'",
        "interval": 3
    },

    "sway/language": {
        "format": "<span color='#3a3a3a'>[ </span><span color='#e8e8e8'><b>key: </b></span>{short}<span color='#3a3a3a'> / </span>",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "<span color='#e8e8e8'><b>vol:</b></span> {volume}%",
        "format-muted": "<span color='#e8e8e8'><b>vol:</b></span> {volume}% (m)"
    },
    
    "battery": {
        "format": "<span color='#3a3a3a'> / </span><span color='#e8e8e8'><b>bat:</b></span> {capacity}%",
        "format-charging": "<span color='#3a3a3a'> / </span><span color='#e8e8e8'><b>ac:</b></span> {capacity}%",
        "tooltip": false,
        "interval": 20
    },

    "backlight": {
        "format": "<span color='#3a3a3a'> / </span><span color='#e8e8e8'><b>mon:</b></span> {percent}%<span color='#3a3a3a'> ]</span>",
        "tooltip": false
    },
    
    "tray": {
        "icon-size": 14,
        "spacing": 7,
        "tooltip": false
    }
}
